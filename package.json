{
  "name": "unscribble",
  "version": "1.0.0",
  "private": true,
  "description": "UnScribble - Making sense of handwritten doctor prescriptions.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "syntax": "node scripts/check-syntax.js",
    "lint": "node scripts/check-syntax.js && node scripts/check-structure.js && eslint .",
    "lint:strict": "npm run lint -- --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/**/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint:strict && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fastest-levenshtein": "^1.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
